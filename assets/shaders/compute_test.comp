#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba8, set = 0, binding = 0) uniform writeonly image2D u_Output;

layout(set = 0, binding = 1) readonly buffer PatternBuffer {
    vec4 colors[];
} u_Pattern;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_Output);

    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec2 uv = vec2(pixel) / vec2(size - 1);

    uint tileX = uint(pixel.x / 32);
    uint tileY = uint(pixel.y / 32);
    uint index = (tileX + tileY * 16) % 256;

    vec3 bufferColor = u_Pattern.colors[index].rgb;

    vec2 centered = uv * 2.0 - 1.0;
    float rings = 0.5 + 0.5 * sin(length(centered) * 40.0);

    vec3 gradient = vec3(uv.x, uv.y, rings);
    vec3 color = mix(gradient, bufferColor, 0.55);

    bool workgroupLine =
        gl_LocalInvocationID.x == 0 ||
        gl_LocalInvocationID.y == 0;

    if (workgroupLine) {
        color = vec3(1.0);
    }

    imageStore(u_Output, pixel, vec4(color, 1.0));
}
